{
    "routes": [
      {
        "route": "/assets/*",
        "headers": {
          "Cache-Control": "public, max-age=2592000"
        }
      },
      {
        "route": "/font/*",
        "headers": {
          "Cache-Control": "public, max-age=2592000"
        }
      }
    ],
    "globalHeaders": {
      "Referrer-Policy": "strict-origin-when-cross-origin"
    },
    "responseOverrides": {
      "404": {
        "rewrite": "/404.html",
        "statusCode": 404
      }
    }
  }
